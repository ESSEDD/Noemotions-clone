---
interface Props {
    frontImage: string;
    backImage: string;
    productName: string;
    price: number;
    altText?: string;
}

const { frontImage, backImage, productName, price, altText = "Product Image" } = Astro.props;
---

<div class="product-card relative group">
    <div class="transition-opacity duration-300 group-hover:opacity-0">
        <img src={frontImage} alt={altText} class="w-full h-85 object-cover">
        <h3 class="mt-4 text-lg font-medium">{productName}</h3>
        <p class="text-gray-600">${price}</p>
    </div>
    <div class="absolute inset-0 opacity-0 transition-opacity duration-300 group-hover:opacity-100">
        <img src={backImage} alt={altText} class="w-full h-85 object-cover">
        <h3 class="mt-4 text-lg font-medium">{productName}</h3>
        <p class="text-gray-600">${price}</p>
        </div>
</div>